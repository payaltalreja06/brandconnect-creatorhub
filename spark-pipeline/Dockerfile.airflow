# Use the official Airflow image
FROM apache/airflow:2.8.1-python3.11

USER root

# Optional: Install any OS-level requirements if needed later
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

USER airflow

# Install requirements one by one to ensure stability
RUN pip install --no-cache-dir \
    google-api-python-client \
    pymongo[srv] \
    dnspython \
    python-dotenv \
    certifi
